<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DieselTools uses nullable annotations without opting into nullable warnings. -->
    <Nullable>annotations</Nullable>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
  </PropertyGroup>

  <!-- ExileApi folder: the HUD passes exapiPackage, CI can pass CI_LIBS_PATH, and a copy in
       <HUD>\Plugins\Source\MapIcons falls back to the HUD three levels up. -->
  <PropertyGroup>
    <DepsDir Condition=" '$(exapiPackage)' != '' ">$(exapiPackage)</DepsDir>
    <DepsDir Condition=" '$(DepsDir)' == '' And '$(CI_LIBS_PATH)' != '' ">$(CI_LIBS_PATH)</DepsDir>
    <DepsDir Condition=" '$(DepsDir)' == '' ">..\..\..</DepsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- DieselTools is compiled into the plugin; its own csproj is only for standalone use. -->
    <Compile Remove="DieselTools_ExileAPI\bin\**;DieselTools_ExileAPI\obj\**" />
    <None Remove="DieselTools_ExileAPI\bin\**;DieselTools_ExileAPI\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Media\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ExileApi-bundled DLLs, referenced from the HUD so versions always match what it loads. -->
  <ItemGroup>
    <Reference Include="ExileCore">
      <HintPath>$(DepsDir)\ExileCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets">
      <HintPath>$(DepsDir)\GameOffsets.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ImGui.NET">
      <HintPath>$(DepsDir)\ImGui.NET.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DepsDir)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>$(DepsDir)\SharpDX.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(DepsDir)\SharpDX.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Linq.Dynamic.Core">
      <HintPath>$(DepsDir)\System.Linq.Dynamic.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SixLabors.ImageSharp">
      <HintPath>$(DepsDir)\SixLabors.ImageSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- WinForms without UseWindowsForms, whose implicit usings make Color ambiguous. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
